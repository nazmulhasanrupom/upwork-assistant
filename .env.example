# Nothing in this file is needed. You can run the app with no .env at all.
# Every line below is optional. Leave it blank or delete it.

# Not needed: the app makes its own key and keeps it in /data/secret_key.
# Set it only if you want to choose the key yourself (32+ random characters).
SECRET_KEY=

# Not needed: the app saves the address of the first page you open.
# You can also change it in Settings. If set here, it wins.
PUBLIC_BASE_URL=

# Claude: you can paste the token on the setup page instead.
CLAUDE_CODE_OAUTH_TOKEN=
ANTHROPIC_API_KEY=

TZ=UTC
LOG_LEVEL=info
DATA_DIR=/data
