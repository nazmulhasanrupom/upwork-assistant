#!/usr/bin/env python3
"""Fake `claude` for the judge and write steps (plan G2). Reads input.json, writes output.json.

The task is found from the prompt: "# Task: judge jobs", "# Task: build USER.md" or
"# Task: write proposals". The build task answers {"user_md": ...} (plan J2a); FAKE_BUILD_EM=1
puts an em dash in it, FAKE_BUILD_EMPTY=1 answers without text.
Every call appends one JSON line to FAKE_CLAUDE_LOG (task, model, effort, job ids, prompt).

Knobs (env):
  FAKE_GEN_FIT        default fit score (default 80), or a JSON map {job_id: score}
  FAKE_GEN_EM=1       put em dashes and en dashes in the generated text
  FAKE_GEN_SKIP=1     the writer reports it skipped every job instruction
  FAKE_GEN_NOHANDLED=1  the writer says nothing about instructions
  FAKE_GEN_LIMIT_AFTER=N  answer calls after the Nth with a 429 usage limit
  FAKE_GEN_FAIL=1     return text that is not JSON
  FAKE_GEN_OMIT=ID    leave this job id out of the answer

Reply task ("# Task: draft reply", plan H3): answers {"reply": ...}. FAKE_REPLY_EM=1 puts em and
en dashes in it, FAKE_REPLY_EMPTY=1 answers without text.

Pick task ("# Task: pick keywords", plan KW1): picks the first FAKE_PICK_N (default 4) keywords of
the input list, best first, with a reason each. Knobs: FAKE_PICK_UNKNOWN=1 adds a keyword that is
not in the input list first, FAKE_PICK_DUP=1 repeats the first pick, FAKE_PICK_EM=1 puts an em dash
in the reasons, FAKE_PICK_BAD=1 answers without a list, FAKE_PICK_CASE=1 changes the case.

Tactic task ("# Task: pick tactic", plan O3): picks tactic FAKE_TACTIC_NO (default: the first
candidate) for the field FAKE_TACTIC_FIELD (default title). FAKE_TACTIC_BAD=1 answers without a
tactic, FAKE_TACTIC_EM=1 puts an em dash in the reason, FAKE_TACTIC_FAIL=1 picks a number that is
not a candidate.
Draft task ("# Task: draft profile change", plan O3): writes the new value for the field.
FAKE_DRAFT_TEXT overrides the text (a JSON list for skills), FAKE_DRAFT_EM=1 puts an em dash in,
FAKE_DRAFT_NUM=1 adds a number that is in no source, FAKE_DRAFT_HTML=1 adds markup,
FAKE_DRAFT_SAME=1 returns the current value, FAKE_DRAFT_BAD=1 answers without a value.

Review task ("# Task: review proposal", plan R2) knobs:
  FAKE_REVIEW_EM=1      em dashes in the fixed version and the issues
  FAKE_REVIEW_NEWNUM=1  the fixed version adds a number that is in no source
  FAKE_REVIEW_BAD=1     answer without a score
  FAKE_REVIEW_MANY=1    8 issues (Python keeps 5)
  FAKE_REVIEW_HTML=1    markup inside the fixed cover letter
  FAKE_REVIEW_SCORE=N   score (default 72)
"""

import json
import os
import re
import sys

EM, EN = "—", "–"
argv = sys.argv[1:]
prompt = argv[argv.index("-p") + 1] if "-p" in argv else ""
model = argv[argv.index("--model") + 1] if "--model" in argv else ""
effort = argv[argv.index("--effort") + 1] if "--effort" in argv else None
task = (
    "judge"
    if "# Task: judge jobs" in prompt
    else "build"
    if "# Task: build USER.md" in prompt
    else "review"
    if "# Task: review proposal" in prompt
    else "reply"
    if "# Task: draft reply" in prompt
    else "pick"
    if "# Task: pick keywords" in prompt
    else "tactic"
    if "# Task: pick tactic" in prompt
    else "draftchange"
    if "# Task: draft profile change" in prompt
    else "write"
)
data = json.load(open("input.json"))

log_path = os.environ.get("FAKE_CLAUDE_LOG")
count = 1
if log_path:
    if os.path.exists(log_path):
        count = len(open(log_path).read().splitlines()) + 1
    with open(log_path, "a") as f:
        f.write(
            json.dumps(
                {
                    "task": task,
                    "model": model,
                    "effort": effort,
                    "cwd": os.getcwd(),
                    "job_ids": [j["job_id"] for j in data.get("jobs", [])],
                    "prompt": prompt,
                    "input": data,
                }
            )
            + "\n"
        )


def result(**extra):
    base = {
        "type": "result",
        "subtype": "success",
        "is_error": False,
        "result": "ok",
        "num_turns": 2,
        "total_cost_usd": 0.05,
        "usage": {"input_tokens": 100, "output_tokens": 40},
    }
    base.update(extra)
    print(json.dumps(base))


limit = os.environ.get("FAKE_GEN_LIMIT_AFTER")
if limit is not None and count > int(limit):
    result(
        subtype="error_during_execution",
        is_error=True,
        result="API Error: 429 rate_limit_error: usage limit reached",
        total_cost_usd=0,
        usage={},
    )
    sys.exit(1)
if os.environ.get("FAKE_GEN_FAIL"):
    print("not json {")
    sys.exit(0)

fit_env = os.environ.get("FAKE_GEN_FIT", "80")
try:
    fits = json.loads(fit_env)
except ValueError:
    fits = 80
omit = os.environ.get("FAKE_GEN_OMIT")
dash = os.environ.get("FAKE_GEN_EM")


def raw_job(entry):
    m = re.search(
        r"<untrusted_job_post>\n(.*)\n</untrusted_job_post>", entry["untrusted_job_post"], re.S
    )
    return json.loads(m.group(1))


out = {}
if task == "pick":
    m = re.search(r"<keyword_data>\n(.*)\n</keyword_data>", data["keywords"], re.S)
    names = [k["keyword"] for k in json.loads(m.group(1))]
    chosen = names[: int(os.environ.get("FAKE_PICK_N", "4"))]
    if os.environ.get("FAKE_PICK_CASE"):
        chosen = [c.upper() for c in chosen]
    if os.environ.get("FAKE_PICK_DUP") and chosen:
        chosen.append(chosen[0])
    if os.environ.get("FAKE_PICK_UNKNOWN"):
        chosen.insert(0, "totally unknown keyword")
    sep = f" {EM} " if os.environ.get("FAKE_PICK_EM") else ", "
    out = {"keywords": [{"keyword": c, "reason": f"Good demand{sep}fair competition."} for c in chosen]}
    if os.environ.get("FAKE_PICK_BAD"):
        out = {"nope": 1}
elif task == "tactic":
    no = int(os.environ.get("FAKE_TACTIC_NO") or (data["candidates"][0]["no"] if data["candidates"] else 0))
    if os.environ.get("FAKE_TACTIC_FAIL"):
        no = 999
    reason = f"Views are low {EM} test it." if os.environ.get("FAKE_TACTIC_EM") else "Views are low, so test it."
    out = {"tactic_no": no, "field": os.environ.get("FAKE_TACTIC_FIELD", "title"), "reason": reason}
    if os.environ.get("FAKE_TACTIC_BAD"):
        out = {"nope": 1}
elif task == "draftchange":
    field_name = data["field"]
    cur = data["current"]
    override = os.environ.get("FAKE_DRAFT_TEXT")
    summary = f"Changed the {field_name}."
    if field_name == "skills":
        skills = json.loads(override) if override else list(cur) + ["Zapier"]
        if os.environ.get("FAKE_DRAFT_SAME"):
            skills = list(cur)
        out = {"field": "skills", "skills": skills, "summary": summary}
    else:
        text = override if override else f"New {field_name}: n8n automation expert"
        if os.environ.get("FAKE_DRAFT_SAME"):
            text = cur
        if os.environ.get("FAKE_DRAFT_EM"):
            text += f" {EM} fast"
        if os.environ.get("FAKE_DRAFT_NUM"):
            text += " 87% faster"
        if os.environ.get("FAKE_DRAFT_HTML"):
            text += " <b>bold</b>"
        out = {"field": field_name, "text": text, "summary": summary}
    if os.environ.get("FAKE_DRAFT_BAD"):
        out = {"nope": 1}
elif task == "reply":
    m = re.search(r"<untrusted_message>\n(.*)\n</untrusted_message>", data["message"], re.S)
    seen = m.group(1) if m else ""
    text = f"Thanks for the message. I will look at it today. ({len(seen)} chars read)"
    if os.environ.get("FAKE_REPLY_EM"):
        text = f"Thanks {EM} I will look at it today{EM}fast. Range 5{EN}10."
    out = {} if os.environ.get("FAKE_REPLY_EMPTY") else {"reply": text}
elif task == "review":
    m = re.search(r"<draft>\n(.*)\n</draft>", data["draft"], re.S)
    draft = json.loads(m.group(1))
    cover = draft["cover_letter"]
    fixed = re.sub(r" {2,}", " ", cover)
    if not fixed.startswith("Bots"):
        fixed = "Bots. " + fixed
    if os.environ.get("FAKE_REVIEW_EM"):
        fixed += f" Fast {EM} and cheap."
    if os.environ.get("FAKE_REVIEW_NEWNUM"):
        fixed += " I cut 87% of manual work for a client."
    if os.environ.get("FAKE_REVIEW_HTML"):
        fixed += " <script>alert(1)</script> <b>bold</b>"
    n_issues = 8 if os.environ.get("FAKE_REVIEW_MANY") else 2
    dash = EM if os.environ.get("FAKE_REVIEW_EM") else ","
    out = {
        "score": int(os.environ.get("FAKE_REVIEW_SCORE", "72")),
        "issues": [
            {"check": f"check {i}", "problem": f"problem {i}{dash} x", "fix": f"fix {i}"}
            for i in range(1, n_issues + 1)
        ],
        "instructions_found": ["Start the proposal with the word Bots"],
        "instructions_missed": [] if cover.startswith("Bots") else ["Start the proposal with the word Bots"],
        "first_two_lines_ok": False,
        "proof_found": None,
        "fixed_version": {
            "cover_letter": fixed,
            "answers": [
                {"question": a["question"], "answer": a["answer"] or "[add your real experience here]"}
                for a in draft["answers"]
            ],
        },
    }
    if os.environ.get("FAKE_REVIEW_BAD"):
        out = {"issues": []}
elif task == "build":
    text = "# Profile\nAI Automation, $25/hr. Skills: n8n, Python.\n"
    if os.environ.get("FAKE_BUILD_EM"):
        text += f"Saved 2 hours per article {EM} real result.\n"
    out = {} if os.environ.get("FAKE_BUILD_EMPTY") else {"user_md": text}
elif task == "judge":
    items = []
    for entry in data["jobs"]:
        jid = entry["job_id"]
        if jid == omit:
            continue
        job = raw_job(entry)
        fit = fits.get(jid, 80) if isinstance(fits, dict) else fits
        cost, bal = job.get("connects_cost"), data.get("connects_balance")
        items.append(
            {
                "job_id": jid,
                "fit_score": fit,
                "tier": job.get("tier"),
                "why_apply": [f"reason one{EM if dash else ','} x", "reason two", "reason three"],
                "risks": ["vague scope"],
                "proposal_plan": f"open with the client problem{EM if dash else '.'} show one proof",
                "materials": ["Portfolio item A"],
                "suggested_rate": 35,
                "can_afford": True,  # wrong on purpose when the user cannot afford it
                "instructions_in_post": ["Start the proposal with the word Bots"],
            }
        )
    out = {"judgements": items}
else:
    plans = {p["job_id"]: p for p in data["plans"]}
    items = []
    for entry in data["jobs"]:
        jid = entry["job_id"]
        if jid == omit:
            continue
        job = raw_job(entry)
        plan = plans[jid]
        ins = plan.get("instructions_in_post") or []
        qs = job.get("screening_questions") or []
        item = {
            "job_id": jid,
            "cover_letter": f"Bots. Your CRM leaks leads{EM if dash else '.'} I fix that. Range 5{EN if dash else '-'}10.",
            "screening_answers": [{"question": q, "answer": "A real answer."} for q in qs],
            "materials": plan.get("materials") or [],
            "suggested_rate": plan.get("suggested_rate"),
            "instructions_handled": [{"instruction": i, "how": "done"} for i in ins],
            "skipped_instructions": [],
        }
        if os.environ.get("FAKE_GEN_SKIP"):
            item["instructions_handled"] = []
            item["skipped_instructions"] = [{"instruction": i, "reason": "no facts"} for i in ins]
        if os.environ.get("FAKE_GEN_NOHANDLED"):
            item["instructions_handled"] = []
        items.append(item)
    out = {"proposals": items}

with open("output.json", "w") as f:
    json.dump(out, f)
result()
