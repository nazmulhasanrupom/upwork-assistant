#!/usr/bin/env python3
"""Fake `claude` for the Chat tests (plan C1).

FAKE_CHAT_REPLIES  path of a JSON list of reply texts, used in order (the last one repeats)
FAKE_CHAT_COUNTER  path of a text file that counts the calls
FAKE_COST          total_cost_usd of each call (default 0.01)
FAKE_CLAUDE_LOG    one JSON line per call: argv and cwd
"""

import json
import os
import sys

argv = sys.argv[1:]
log_path = os.environ.get("FAKE_CLAUDE_LOG")
if log_path:
    with open(log_path, "a") as f:
        f.write(json.dumps({"argv": argv, "cwd": os.getcwd()}) + "\n")

counter = os.environ.get("FAKE_CHAT_COUNTER")
n = 0
if counter:
    try:
        n = int(open(counter).read() or 0)
    except OSError:
        n = 0
    with open(counter, "w") as f:
        f.write(str(n + 1))

replies = json.load(open(os.environ["FAKE_CHAT_REPLIES"])) if os.environ.get("FAKE_CHAT_REPLIES") else ["Hello."]
text = replies[min(n, len(replies) - 1)]
print(json.dumps({
    "type": "result", "subtype": "success", "is_error": False, "result": text, "num_turns": 1,
    "total_cost_usd": float(os.environ.get("FAKE_COST", "0.01")),
    "usage": {"input_tokens": 100, "output_tokens": 20},
}))
